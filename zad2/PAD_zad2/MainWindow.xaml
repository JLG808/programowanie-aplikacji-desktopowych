<Window x:Class="PAD_zad2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Window.Resources>

        <!-- Domyślny styl wszystkich przycisków -->
        <Style TargetType="Button">

            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="Black"/>

            <Style.Triggers>

                <!-- Najechanie -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="Blue"/>
                </Trigger>

                <!-- Kliknięcie -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Alternatywny styl przycisku -->
        <Style x:Key="SpecialButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="LightGreen"/>
            <Setter Property="BorderBrush" Value="DarkGreen"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Margin" Value="3"/>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- Wiersze -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Kolumny -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Górna belka -->
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Background="LightBlue">

            <Button Content="Przycisk 1"/>

            <Button Content="Top Special"
                    Style="{StaticResource SpecialButtonStyle}"/>

        </StackPanel>

        <!-- Lewa belka (sub-grid) -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Background="LightYellow">

            <Grid.Resources>

                <!-- Styl tylko dla przycisków w lewej belce -->
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Khaki"/>
                </Style>

            </Grid.Resources>

            <StackPanel>

                <Button Content="Lewy 1"/>

                <Button Content="Left Special"
                        Style="{StaticResource SpecialButtonStyle}"/>

            </StackPanel>

        </Grid>

        <!-- Obszar zawartości -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Background="WhiteSmoke">

            <TextBlock Text="Przestrzeń na zawartość"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- Dolna belka -->
        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Background="LightCoral">

            <Button Content="Dolny 1"/>

            <Button Content="Bottom Special"
                    Style="{StaticResource SpecialButtonStyle}"/>

        </StackPanel>

    </Grid>

</Window>