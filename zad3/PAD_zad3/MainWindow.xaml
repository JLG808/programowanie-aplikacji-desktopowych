<Window x:Class="PAD_zad3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Osoba" Height="300" Width="400">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Imię i nazwisko"/>

            <TextBox
                Text="{Binding ImieNazwisko, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,5,0,10"/>

            <TextBlock Text="Data urodzin"/>

            <TextBox
                Text="{Binding DataUrodzin, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,5,0,20"/>

            <TextBlock
                Text="{Binding PierwszeImie, StringFormat=Pierwsze imię: {0}}"/>

            <TextBlock
                Text="{Binding Nazwisko, StringFormat=Nazwisko: {0}}"/>

            <TextBlock
                Text="{Binding Wiek, StringFormat=Wiek: {0}}"/>

        </StackPanel>
    </Grid>

</Window>